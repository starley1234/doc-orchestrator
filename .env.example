# Настройки для боевого сервера (docker-compose.prod.yml) и запуска без Docker.
# Все переменные необязательны: значения по умолчанию заданы в app/config.py
# и подходят тестовому стенду (docker-compose.yml).
#
# На боевом сервере файл .env создаёт `deploy/install.sh orchestrator`: берёт этот образец
# и подставляет значения, указанные ниже в строках «Боевой сервер». Вручную: скопируйте
# файл в .env и замените эти значения сами.

LOG_LEVEL=INFO
# Боевой сервер: redis://doc-redis:6379/0
REDIS_URL=redis://redis:6379/0

# --- ML-движки ---
# По умолчанию — заглушка mock-engines из docker-compose.yml.
# Для запуска без Docker замените хосты redis и mock-engines на localhost.
# Боевой сервер: http://engine-gateway:8001/docling, …/mineru, …/paddle — шлюз движков
# (сервис engine-gateway в docker-compose.prod.yml) перед docling-serve, MinerU и PaddleOCR-VL.
DOCLING_URL=http://mock-engines:8001/docling
MINERU_URL=http://mock-engines:8001/mineru
PADDLE_URL=http://mock-engines:8001/paddle
# Боевой сервер: http://ollama-vlm:11434
OLLAMA_URL=http://mock-engines:8001
# Строго instruct-вариант модели, не thinking.
# Боевой сервер: qwen3-vl-doc — профиль той же модели, который создаёт install.sh models
VLM_MODEL=qwen3-vl:4b-instruct-q8_0
# Окно контекста модели, токенов
VLM_NUM_CTX=8192

# --- Доступ ---
# Если задан, PUT /process требует заголовок Authorization: Bearer <ключ>.
# Боевой сервер: случайный ключ — его же нужно указать в Open WebUI (без ключа тот не включает
# внешний загрузчик документов)
API_KEY=

# --- Таймауты, секунды ---
# Один HTTP-запрос к движку (OCR большого скана идёт минуты). Шлюз движков читает ту же
# переменную и прерывает распознавание чуть раньше — на 90 % этого времени
HTTP_TIMEOUT_SEC=300
# TTL лока GPU: если процесс упал, видеокарта освободится через это время
# (работающая задача продлевает лок сама)
GPU_LOCK_TIMEOUT_SEC=300
# Сколько задача ждёт своей очереди к GPU
GPU_LOCK_WAIT_SEC=300
# Простой PaddleOCR-VL, после которого GPU 0 возвращается MinerU, и период этой проверки
PADDLE_IDLE_TTL_SEC=120
GPU0_CHECK_INTERVAL_SEC=15

# --- Файлы и изображения ---
# Предел размера загружаемого файла, МБ
MAX_FILE_SIZE_MB=50
# Предел пикселей картинки для Qwen3-VL (больше не помещается в 8 ГБ VRAM)
MAX_PIXELS=1280000
# Рендер первой страницы документа и чертежа, точек на дюйм
OVERVIEW_DPI=150
DRAWING_DPI=300
# Предел распознанного текста в промпте Qwen3-VL, символов (должен влезать в VLM_NUM_CTX)
VLM_MAX_TEXT_CHARS=8000

# --- Асинхронные задачи (async_mode=true) ---
# Срок хранения состояния и результата задачи, секунды
TASK_TTL_SEC=3600
# Сколько задач обрабатывается одновременно (остальные ждут в очереди)
TASK_CONCURRENCY=2

# --- Шлюз движков (engine-gateway, только боевой сервер) ---
# Значения по умолчанию — имена контейнеров и порты из инструкции по установке (gateway/config.py):
# раскомментируйте строку, только если у вас иначе.
#DOCLING_SERVE_URL=http://docling-serve:5001
#MINERU_API_URL=http://mineru-api:8000
#PADDLE_API_URL=http://paddle-gpu0:8000
# Контейнеры движков GPU 0: шлюз запускает и останавливает их через сокет Docker
#MINERU_CONTAINER=mineru-api
#PADDLE_CONTAINER=paddle-gpu0
#DOCKER_SOCKET=/var/run/docker.sock
# Сколько Docker ждёт завершения движка при остановке, секунды
#CONTAINER_STOP_SEC=30
# Период опроса задачи движка и готовности контейнера, секунды
#POLL_INTERVAL_SEC=1
# OCR картинок внутри цифровых документов в Docling. Выключен: в образе docling-serve нет
# моделей для кириллицы, а сканы и так читают MinerU и PaddleOCR-VL
#DOCLING_DO_OCR=false
# Картинки из скана MinerU, которые описывает Qwen3-VL (секунды на каждую): не больше стольких
# (остаются самые крупные; 0 — без ограничения) и не мельче стольких пикселей по меньшей стороне
#MINERU_MAX_FIGURES=12
#MINERU_MIN_FIGURE_SIDE=100
