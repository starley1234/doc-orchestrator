# Скопируйте в .env и поправьте значения. Все переменные необязательны:
# значения по умолчанию заданы в app/config.py.

LOG_LEVEL=INFO
REDIS_URL=redis://redis:6379/0

# --- ML-движки ---
# По умолчанию — заглушка mock-engines из docker-compose.yml.
# На боевом сервере укажите адреса настоящих движков (см. README.md).
# Для запуска без Docker замените хосты redis и mock-engines на localhost.
DOCLING_URL=http://mock-engines:8001/docling
MINERU_URL=http://mock-engines:8001/mineru
PADDLE_URL=http://mock-engines:8001/paddle
# Боевой Ollama: http://ollama:11434
OLLAMA_URL=http://mock-engines:8001
# Строго instruct-вариант модели, не thinking
VLM_MODEL=qwen3-vl:4b-instruct-q8_0
# Окно контекста модели, токенов
VLM_NUM_CTX=8192

# --- Доступ ---
# Если задан, PUT /process требует заголовок Authorization: Bearer <ключ>
API_KEY=

# --- Таймауты, секунды ---
# Один HTTP-запрос к движку (OCR большого скана идёт минуты)
HTTP_TIMEOUT_SEC=300
# TTL лока GPU: если процесс упал, видеокарта освободится через это время
# (работающая задача продлевает лок сама)
GPU_LOCK_TIMEOUT_SEC=300
# Сколько задача ждёт своей очереди к GPU
GPU_LOCK_WAIT_SEC=300
# Простой PaddleOCR-VL, после которого GPU 0 возвращается MinerU, и период этой проверки
PADDLE_IDLE_TTL_SEC=120
GPU0_CHECK_INTERVAL_SEC=15

# --- Файлы и изображения ---
# Предел размера загружаемого файла, МБ
MAX_FILE_SIZE_MB=50
# Предел пикселей картинки для Qwen3-VL (больше не помещается в 8 ГБ VRAM)
MAX_PIXELS=1280000
# Рендер первой страницы документа и чертежа, точек на дюйм
OVERVIEW_DPI=150
DRAWING_DPI=300
# Предел распознанного текста в промпте Qwen3-VL, символов (должен влезать в VLM_NUM_CTX)
VLM_MAX_TEXT_CHARS=8000

# --- Асинхронные задачи (async_mode=true) ---
# Срок хранения состояния и результата задачи, секунды
TASK_TTL_SEC=3600
# Сколько задач обрабатывается одновременно (остальные ждут в очереди)
TASK_CONCURRENCY=2
