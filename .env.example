# Скопируйте в .env и поправьте значения. Все переменные необязательны:
# значения по умолчанию заданы в app/config.py.

# --- Адреса сервисов ---
# Здесь — адреса внутри docker compose. Для запуска без Docker замените хосты на localhost.
# В проде вместо mock-engines укажите боевые контейнеры движков.
REDIS_URL=redis://redis:6379/0
DOCLING_URL=http://mock-engines:8001/docling
MINERU_URL=http://mock-engines:8001/mineru
PADDLE_URL=http://mock-engines:8001/paddle
VLM_GATEWAY_URL=http://mock-engines:8001/gateway
DLP_URL=http://mock-engines:8001/dlp
VLM_MODEL=qwen3-vl

# --- Доступ ---
# Если задан, PUT /process требует заголовок Authorization: Bearer <токен>
OPENWEBUI_API_TOKEN=

# --- Таймауты, секунды ---
# Один HTTP-запрос к движку (OCR большого скана идёт минуты)
HTTP_TIMEOUT_S=300
# TTL лока GPU: если процесс упал, видеокарта освободится через это время
# (работающая задача продлевает лок сама)
GPU_LOCK_TIMEOUT_S=300
# Сколько задача ждёт своей очереди к GPU
GPU_WAIT_TIMEOUT_S=600
# Простой paddle, после которого GPU 0 возвращается mineru, и период этой проверки
PADDLE_IDLE_TTL_S=120
IDLE_CHECK_INTERVAL_S=30

# --- Файлы, изображения и текст для Qwen3-VL ---
# Предел размера загружаемого файла, МБ
MAX_FILE_SIZE_MB=50
# Предел пикселей картинки для Qwen3-VL (больше не помещается в 8 ГБ VRAM)
MAX_PIXELS=1280000
RENDER_DPI=200
DRAWING_DPI=300
VLM_MAX_TEXT_CHARS=20000

# --- Асинхронные задачи (async_mode=true) ---
# Число фоновых воркеров, срок хранения результата и период опроса очереди
TASK_WORKERS=2
TASK_TTL_S=86400
TASK_POLL_INTERVAL_S=0.5

LOG_LEVEL=INFO
