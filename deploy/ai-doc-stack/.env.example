# Настройки OCR/VLM-стека: скопируйте в .env рядом с docker-compose.yml (install.sh делает это сам).
# После правки примените их: sudo bash deploy/install.sh stack (из каталога репозитория doc-orchestrator).
# Вручную — cd /opt/ai-doc-stack && docker compose --profile webui up -d, но только пока на GPU 0
# работает MinerU, а не PaddleOCR-VL: эта команда запускает mineru-api.

# Уровень MinerU.
#   standard — текст читает VLM-модель MinerU2.5-Pro, понимает кириллицу; GPU 0 занят почти целиком
#              (vLLM резервирует 6 ГБ из 8, остальное — малые модели);
#   basic    — только малые модели, ~4 ГБ VRAM, но кириллицу НЕ распознаёт: в словаре PP-OCRv6 её нет.
MINERU_TIER=standard

# На каком адресе сервера открыть порты движков: 5001 (Docling), 7860 и 8002 (MinerU),
# 8003 (PaddleOCR-VL), 11434 (Ollama). 0.0.0.0 — на всех интерфейсах, как в инструкции.
# Авторизации у движков нет, а правила ufw на порты Docker не действуют: если сервер виден
# из недоверенной сети, укажите адрес внутреннего интерфейса или 127.0.0.1.
BIND_ADDR=0.0.0.0

# С каким разрешением PaddleOCR-VL рендерит страницы PDF. Меньше — меньше видеопамяти, но мельче текст.
PADDLE_OCR_DPI=150
